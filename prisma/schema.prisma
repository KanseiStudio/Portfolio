generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Projects ----------

model Project {
  id           Int      @id @default(autoincrement())
  slug         String   @unique @db.VarChar(120)
  year         Int
  client       String   @db.VarChar(180)
  format       String   @db.VarChar(120)
  environment  String   @db.VarChar(180)
  technologies String   @db.Text
  notes        String?  @db.Text
  videoUrl     String?  @map("video_url") @db.VarChar(255)
  posterUrl    String?  @map("poster_url") @db.VarChar(255)
  coverUrl     String?  @map("cover_url") @db.VarChar(255)
  published    Boolean  @default(true)
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  translations ProjectTranslation[]
  categories   ProjectCategory[]
  kpis         ProjectKpi[]

  @@map("projects")
}

model ProjectTranslation {
  projectId   Int     @map("project_id")
  locale      String  @db.VarChar(5)
  title       String  @db.VarChar(200)
  tagline     String? @db.VarChar(250)
  description String  @db.Text
  problem     String? @db.Text
  solution    String? @db.Text

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, locale])
  @@map("project_translations")
}

// ---------- Categories ----------

model Category {
  id        Int    @id @default(autoincrement())
  slug      String @unique @db.VarChar(60)
  sortOrder Int    @default(0) @map("sort_order")

  translations CategoryTranslation[]
  projects     ProjectCategory[]

  @@map("categories")
}

model CategoryTranslation {
  categoryId Int    @map("category_id")
  locale     String @db.VarChar(5)
  name       String @db.VarChar(80)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([categoryId, locale])
  @@map("category_translations")
}

model ProjectCategory {
  projectId  Int @map("project_id")
  categoryId Int @map("category_id")

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([projectId, categoryId])
  @@map("project_categories")
}

// ---------- KPIs ----------

model ProjectKpi {
  id        Int    @id @default(autoincrement())
  projectId Int    @map("project_id")
  icon      String @db.VarChar(30)
  value     String @db.VarChar(20)
  sortOrder Int    @default(0) @map("sort_order")

  project      Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  translations ProjectKpiTranslation[]

  @@map("project_kpis")
}

model ProjectKpiTranslation {
  kpiId  Int    @map("kpi_id")
  locale String @db.VarChar(5)
  label  String @db.VarChar(150)

  kpi ProjectKpi @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@id([kpiId, locale])
  @@map("project_kpi_translations")
}

// ---------- Technologies ----------

model Technology {
  id          Int      @id @default(autoincrement())
  slug        String   @unique @db.VarChar(120)
  name        String   @db.VarChar(120)
  videoUrl    String?  @map("video_url") @db.VarChar(255)
  mainImage   String?  @map("main_image") @db.VarChar(255)
  usageImage1 String?  @map("usage_image_1") @db.VarChar(255)
  usageImage2 String?  @map("usage_image_2") @db.VarChar(255)
  usageImage3 String?  @map("usage_image_3") @db.VarChar(255)
  published   Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  translations TechnologyTranslation[]

  @@map("technologies")
}

model TechnologyTranslation {
  id           Int    @id @default(autoincrement())
  technologyId Int    @map("technology_id")
  locale       String @db.VarChar(5)
  description  String @db.Text
  applications String @db.Text

  technology Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@unique([technologyId, locale])
  @@map("technology_translations")
}

// ---------- Contact Info (singleton) ----------

model ContactInfo {
  id         Int      @id @default(autoincrement())
  studioName String   @default("Kansei Studio") @map("studio_name") @db.VarChar(120)
  email      String   @db.VarChar(180)
  updatedAt  DateTime @updatedAt @map("updated_at")

  translations ContactInfoTranslation[]

  @@map("contact_info")
}

model ContactInfoTranslation {
  id            Int    @id @default(autoincrement())
  contactInfoId Int    @map("contact_info_id")
  locale        String @db.VarChar(5)
  location      String @db.VarChar(180)
  availability  String @db.VarChar(250)
  focus         String @db.VarChar(250)

  contactInfo ContactInfo @relation(fields: [contactInfoId], references: [id], onDelete: Cascade)

  @@unique([contactInfoId, locale])
  @@map("contact_info_translations")
}

// ---------- Site Settings (singleton) ----------

model SiteSettings {
  id           String   @id @default("singleton")
  musicUrl     String?  @map("music_url") @db.VarChar(500)
  musicEnabled Boolean  @default(false) @map("music_enabled")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

// ---------- Contact Channels ----------

model ContactChannel {
  id        Int      @id @default(autoincrement())
  platform  String   @db.VarChar(60)
  iconName  String   @map("icon_name") @db.VarChar(60)
  handle    String   @db.VarChar(200)
  url       String?  @db.VarChar(255)
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  translations ContactChannelTranslation[]

  @@map("contact_channels")
}

model ContactChannelTranslation {
  id               Int    @id @default(autoincrement())
  contactChannelId Int    @map("contact_channel_id")
  locale           String @db.VarChar(5)
  label            String @db.VarChar(120)

  contactChannel ContactChannel @relation(fields: [contactChannelId], references: [id], onDelete: Cascade)

  @@unique([contactChannelId, locale])
  @@map("contact_channel_translations")
}

// ---------- Works ----------
// Pagine prodotto (KDoors, KBox, K-Avatar…) composte da sezioni a blocchi ordinabili.
// Campi bilingui come coppie di colonne xxxIt / xxxEn.

enum HeroTone {
  DARK  // angoli HUD e didascalia scuri (immagine chiara)
  LIGHT // angoli HUD e didascalia chiari (immagine scura)
}

enum SectionKind {
  CARDS    // griglia di celle: label, titolo, testo
  TIMELINE // righe numerate con tempo a destra
  TABLE    // righe a 3 colonne con intestazione
  SPECS    // tabella etichetta / valore
  GALLERY  // immagini con didascalia
  QUOTE    // box citazione con barra rossa
  IMAGE    // immagine larga a tutta colonna
  SPLIT    // immagine a sinistra + celle a destra
}

model Work {
  id          String   @id @default(cuid())
  slug        String   @unique @db.VarChar(120)
  name        String   @db.VarChar(120) // non si traduce
  order       Int      @default(0) @map("sort_order")
  published   Boolean  @default(false)
  typeIt      String   @map("type_it") @db.VarChar(180)
  typeEn      String   @map("type_en") @db.VarChar(180)
  typeShortIt String?  @map("type_short_it") @db.VarChar(120) // tipologia breve per la tabella indice (fallback: type)
  typeShortEn String?  @map("type_short_en") @db.VarChar(120)
  statusIt    String   @map("status_it") @db.VarChar(80)
  statusEn    String   @map("status_en") @db.VarChar(80)
  taglineIt   String   @map("tagline_it") @db.VarChar(300)
  taglineEn   String   @map("tagline_en") @db.VarChar(300)
  introIt     String   @map("intro_it") @db.Text
  introEn     String   @map("intro_en") @db.Text
  summaryIt   String?  @map("summary_it") @db.Text // testo della scheda nell'indice (fallback: intro)
  summaryEn   String?  @map("summary_en") @db.Text
  closingIt   String?  @map("closing_it") @db.Text // frase finale prima del "Prossimo"
  closingEn   String?  @map("closing_en") @db.Text
  ctaLabelIt  String?  @map("cta_label_it") @db.VarChar(120)
  ctaLabelEn  String?  @map("cta_label_en") @db.VarChar(120)
  heroImage   String   @map("hero_image") @db.VarChar(500)
  heroAltIt   String   @map("hero_alt_it") @db.VarChar(300)
  heroAltEn   String   @map("hero_alt_en") @db.VarChar(300)
  heroCaption String?  @map("hero_caption") @db.VarChar(160)
  heroTone    HeroTone @default(DARK) @map("hero_tone")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tags     WorkTag[]
  stats    WorkStat[]
  sections  WorkSection[]
  artifacts WorkArtifact[]

  @@map("works")
}

model WorkTag {
  id      String @id @default(cuid())
  workId  String @map("work_id")
  order   Int    @map("sort_order")
  labelIt String @map("label_it") @db.VarChar(80)
  labelEn String @map("label_en") @db.VarChar(80)

  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@index([workId])
  @@map("work_tags")
}

model WorkStat {
  id          String  @id @default(cuid())
  workId      String  @map("work_id")
  order       Int     @map("sort_order")
  value       String  @db.VarChar(40) // "45–60″", "500+", "H24"
  labelIt     String  @map("label_it") @db.VarChar(200)
  labelEn     String  @map("label_en") @db.VarChar(200)
  cardLabelIt String? @map("card_label_it") @db.VarChar(80) // etichetta breve nella scheda indice (fallback: label)
  cardLabelEn String? @map("card_label_en") @db.VarChar(80)
  onCard      Boolean @default(false) @map("on_card") // max 3: mostrati nella scheda dell'indice
  onPage      Boolean @default(true) @map("on_page")  // mostrato nella fascia stats della pagina

  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@index([workId])
  @@map("work_stats")
}

model WorkSection {
  id         String      @id @default(cuid())
  workId     String      @map("work_id")
  order      Int         @map("sort_order")
  kind       SectionKind
  eyebrowIt  String?     @map("eyebrow_it") @db.VarChar(160) // "03 — L'esperienza"
  eyebrowEn  String?     @map("eyebrow_en") @db.VarChar(160)
  titleIt    String?     @map("title_it") @db.VarChar(300)
  titleEn    String?     @map("title_en") @db.VarChar(300)
  bodyIt     String?     @map("body_it") @db.Text
  bodyEn     String?     @map("body_en") @db.Text
  columnsIt  String?     @map("columns_it") @db.VarChar(300) // intestazioni TABLE separate da " | "
  columnsEn  String?     @map("columns_en") @db.VarChar(300)
  image      String?     @db.VarChar(500)
  imageAltIt String?     @map("image_alt_it") @db.VarChar(300)
  imageAltEn String?     @map("image_alt_en") @db.VarChar(300)

  work  Work              @relation(fields: [workId], references: [id], onDelete: Cascade)
  items WorkSectionItem[]

  @@index([workId])
  @@map("work_sections")
}

model WorkSectionItem {
  id         String  @id @default(cuid())
  sectionId  String  @map("section_id")
  order      Int     @map("sort_order")
  labelIt    String? @map("label_it") @db.VarChar(160) // "01", "Un citofono", "Passante"
  labelEn    String? @map("label_en") @db.VarChar(160)
  titleIt    String? @map("title_it") @db.VarChar(300)
  titleEn    String? @map("title_en") @db.VarChar(300)
  bodyIt     String? @map("body_it") @db.Text
  bodyEn     String? @map("body_en") @db.Text
  extraIt    String? @map("extra_it") @db.VarChar(300) // 3ª colonna TABLE o tempo TIMELINE ("3–12″")
  extraEn    String? @map("extra_en") @db.VarChar(300)
  image      String? @db.VarChar(500)
  imageAltIt String? @map("image_alt_it") @db.VarChar(300)
  imageAltEn String? @map("image_alt_en") @db.VarChar(300)

  section WorkSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
  @@map("work_section_items")
}

// ---------- Artefatti interattivi dei Works ----------
// Mini-siti HTML autonomi (HTML + JS + asset) su Vercel Blob, mostrati in iframe nella pagina del lavoro.
// File in artifacts/<blobPrefix>/...; l'HTML entry è servito da /artifacts/[id], gli asset dal rewrite /artifact-files/*.
// onDelete: Cascade elimina i record ma NON i blob: le action di delete puliscono prima i prefix.

model WorkArtifact {
  id          String   @id @default(cuid())
  workId      String   @map("work_id")
  titleIt     String   @map("title_it") @db.VarChar(200)
  titleEn     String?  @map("title_en") @db.VarChar(200)
  captionIt   String?  @map("caption_it") @db.Text
  captionEn   String?  @map("caption_en") @db.Text
  blobPrefix  String   @map("blob_prefix") @db.VarChar(200) // "<workId>/<uploadId>" → artifacts/<blobPrefix>/...
  // Versione sostituita, tenuta finché non arriva la successiva: l'HTML in cache CDN (fino a 5 min)
  // punta ancora alla sua <base>, cancellarla subito manderebbe i video in 404.
  previousBlobPrefix String? @map("previous_blob_prefix") @db.VarChar(200)
  entryPath   String   @default("index.html") @map("entry_path") @db.VarChar(300)
  aspectRatio String   @default("16/9") @map("aspect_ratio") @db.VarChar(10)
  posterUrl   String?  @map("poster_url") @db.VarChar(500)
  fileCount   Int      @map("file_count")
  totalBytes  Int      @map("total_bytes")
  position    Int      @default(0)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@index([workId, position])
  @@map("work_artifacts")
}
