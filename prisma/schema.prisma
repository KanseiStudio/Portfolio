generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Projects ----------

model Project {
  id           Int      @id @default(autoincrement())
  slug         String   @unique @db.VarChar(120)
  year         Int
  client       String   @db.VarChar(180)
  format       String   @db.VarChar(120)
  environment  String   @db.VarChar(180)
  technologies String   @db.Text
  notes        String?  @db.Text
  videoUrl     String?  @map("video_url") @db.VarChar(255)
  posterUrl    String?  @map("poster_url") @db.VarChar(255)
  coverUrl     String?  @map("cover_url") @db.VarChar(255)
  published    Boolean  @default(true)
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  translations ProjectTranslation[]
  categories   ProjectCategory[]
  kpis         ProjectKpi[]

  @@map("projects")
}

model ProjectTranslation {
  projectId   Int     @map("project_id")
  locale      String  @db.VarChar(5)
  title       String  @db.VarChar(200)
  tagline     String? @db.VarChar(250)
  description String  @db.Text
  problem     String? @db.Text
  solution    String? @db.Text

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, locale])
  @@map("project_translations")
}

// ---------- Categories ----------

model Category {
  id        Int    @id @default(autoincrement())
  slug      String @unique @db.VarChar(60)
  sortOrder Int    @default(0) @map("sort_order")

  translations CategoryTranslation[]
  projects     ProjectCategory[]

  @@map("categories")
}

model CategoryTranslation {
  categoryId Int    @map("category_id")
  locale     String @db.VarChar(5)
  name       String @db.VarChar(80)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([categoryId, locale])
  @@map("category_translations")
}

model ProjectCategory {
  projectId  Int @map("project_id")
  categoryId Int @map("category_id")

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([projectId, categoryId])
  @@map("project_categories")
}

// ---------- KPIs ----------

model ProjectKpi {
  id        Int    @id @default(autoincrement())
  projectId Int    @map("project_id")
  icon      String @db.VarChar(30)
  value     String @db.VarChar(20)
  sortOrder Int    @default(0) @map("sort_order")

  project      Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  translations ProjectKpiTranslation[]

  @@map("project_kpis")
}

model ProjectKpiTranslation {
  kpiId  Int    @map("kpi_id")
  locale String @db.VarChar(5)
  label  String @db.VarChar(150)

  kpi ProjectKpi @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@id([kpiId, locale])
  @@map("project_kpi_translations")
}

// ---------- Technologies ----------

model Technology {
  id          Int      @id @default(autoincrement())
  slug        String   @unique @db.VarChar(120)
  name        String   @db.VarChar(120)
  videoUrl    String?  @map("video_url") @db.VarChar(255)
  mainImage   String?  @map("main_image") @db.VarChar(255)
  usageImage1 String?  @map("usage_image_1") @db.VarChar(255)
  usageImage2 String?  @map("usage_image_2") @db.VarChar(255)
  usageImage3 String?  @map("usage_image_3") @db.VarChar(255)
  published   Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  translations TechnologyTranslation[]

  @@map("technologies")
}

model TechnologyTranslation {
  id           Int    @id @default(autoincrement())
  technologyId Int    @map("technology_id")
  locale       String @db.VarChar(5)
  description  String @db.Text
  applications String @db.Text

  technology Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@unique([technologyId, locale])
  @@map("technology_translations")
}

// ---------- Contact Info (singleton) ----------

model ContactInfo {
  id         Int      @id @default(autoincrement())
  studioName String   @default("Kansei Studio") @map("studio_name") @db.VarChar(120)
  email      String   @db.VarChar(180)
  updatedAt  DateTime @updatedAt @map("updated_at")

  translations ContactInfoTranslation[]

  @@map("contact_info")
}

model ContactInfoTranslation {
  id            Int    @id @default(autoincrement())
  contactInfoId Int    @map("contact_info_id")
  locale        String @db.VarChar(5)
  location      String @db.VarChar(180)
  availability  String @db.VarChar(250)
  focus         String @db.VarChar(250)

  contactInfo ContactInfo @relation(fields: [contactInfoId], references: [id], onDelete: Cascade)

  @@unique([contactInfoId, locale])
  @@map("contact_info_translations")
}

// ---------- Contact Channels ----------

model ContactChannel {
  id        Int      @id @default(autoincrement())
  platform  String   @db.VarChar(60)
  iconName  String   @map("icon_name") @db.VarChar(60)
  handle    String   @db.VarChar(200)
  url       String?  @db.VarChar(255)
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  translations ContactChannelTranslation[]

  @@map("contact_channels")
}

model ContactChannelTranslation {
  id               Int    @id @default(autoincrement())
  contactChannelId Int    @map("contact_channel_id")
  locale           String @db.VarChar(5)
  label            String @db.VarChar(120)

  contactChannel ContactChannel @relation(fields: [contactChannelId], references: [id], onDelete: Cascade)

  @@unique([contactChannelId, locale])
  @@map("contact_channel_translations")
}
